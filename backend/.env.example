# ============================================
# VialSafe - Plantilla de variables de entorno
# Copiar a .env y rellenar con valores reales
# ============================================

# MongoDB Atlas
DB_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/vialsafe?retryWrites=true&w=majority

# Servidor
PORT=4000
NODE_ENV=development

# Autenticación JWT
JWT_SECRET=change_me_in_local_env
JWT_EXPIRES_IN=7d
